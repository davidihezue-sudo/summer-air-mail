# All optional. Copy to .env or set these on your host. Never commit real values.

# Port and bind address. Hosts that set PORT bind to 0.0.0.0 automatically.
PORT=8787
# HOST=127.0.0.1

# Where content.json, admin.json and uploads/ live. Put this on a persistent disk and back it up.
DATA_DIR=data

# Admin login without a data folder (for hosts with no persistent disk for admin.json).
# Create the hash with: npm run admin:hash
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# Behind a proxy or load balancer (Render, Fly, Nginx): number of proxies to trust so HTTPS and client IPs are detected.
# TRUST_PROXY=1
# Force the Secure flag on the session cookie.
# COOKIE_SECURE=true
# Extra origins allowed to call the admin API (comma separated). Normally not needed.
# ALLOWED_ORIGINS=

# Session length in hours, failed logins allowed per 15 minutes, upload limit in MB.
# SESSION_HOURS=8
# LOGIN_MAX_ATTEMPTS=5
# MAX_UPLOAD_MB=60

# ---------- Version 3 ----------
# Store content, messages, subscribers, insights and settings in Postgres instead of files.
# Uploaded images and files still live in DATA_DIR (use a persistent disk).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email alerts for new messages (any SMTP provider). Leave empty to turn email off.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Portfolio <alerts@example.com>"
# Webhook for the same alerts (Slack, Discord, Zapier). Must be https.
# ALERT_WEBHOOK_URL=

# Optional off-site backups to S3 compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=backups/
