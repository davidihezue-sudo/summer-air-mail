{
  "name": "summer-air-mail",
  "version": "3.0.0",
  "private": true,
  "description": "Summer Air Mail: a four-season social media and digital marketing portfolio with a built-in admin",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server shared scripts",
    "test": "vitest run",
    "images": "node scripts/optimize-images.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:server": "node --watch server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "node server/index.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "admin:hash": "node scripts/admin-setup.mjs --hash",
    "data:import": "node scripts/data-import.mjs",
    "db:up": "docker compose up -d db",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:v3": "node scripts/smoke-v3.mjs",
    "a11y": "node scripts/a11y.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:phone": "node scripts/dev-all.mjs --host",
    "go": "node scripts/go.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "archiver": "^8.0.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
